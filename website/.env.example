LLM_API_KEY=
LLM_BASE_URL=https://changellenge.up.railway.app/v1
LLM_MODEL=deepseek/deepseek-v4.1-flash
LLM_REVIEW_MODEL=qwen/qwen3.6-35b-a3b
# Optional verified RUB prices per million tokens, JSON by model: {"model":{"input":0,"output":0}}
# Leave empty when prices are unknown. Do not use example zeros as real tariffs.
LLM_PRICES_RUB_PER_MILLION=
LLM_DAILY_BUDGET_RUB=500
# Optional paths outside the repository for cache and metadata-only audit:
LLM_CACHE_DIR=
LLM_AUDIT_PATH=
# Runtime data and accounts must be outside the repository.
APP_DATA_DIR=
PROFILES_FILE=
# Optional original CSV folder; npm start rebuilds large-business profiles automatically.
DATASET_DIR=
PYTHON_EXE=
ML_ENABLED=1
ML_PYTHON_EXE=
ML_EXTRACT_MODEL=google/gemma-4-26b-a4b-it
AUTH_USERS_FILE=
SOURCE_REFRESH_MINUTES=60
# Optional launcher configuration:
BACKEND_PATH=
BACKEND_PORT=5194
PORT=4173
