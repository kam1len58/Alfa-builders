# В репозиторий входят только сайт, исходные данные и средства его запуска/обновления.
/*
!/.gitignore
!/README.md
!/THIRD_PARTY_NOTICES
!/package.json
!/pnpm-lock.yaml
!/pnpm-workspace.yaml
!/analytics/
!/Dockerfile
!/.dockerignore
!/compose.yaml
!/ARCHITECTURE.md
!/QUALITY.md
!/HANDOFF.md
!/DEMO.md
!/API_CONTRACT.md
!/server.mjs
!/server/
!/dist/
!/data/
!/config/
!/scripts/
!/test/

/data/*
!/data/*.xlsx
!/data/*.json
/config/*
!/config/sources.json
!/config/bank-excerpts.json
!/config/prepared-news.json
/scripts/*
!/scripts/*.mjs
/test/*
!/test/*.test.mjs
/analytics/*
!/analytics/*.py

# Локальные настройки, инструменты агента и временные результаты.
.openai/
.codex/
.vscode/
.idea/
AGENTS.md
node_modules/
__pycache__/
*.pyc
.DS_Store
Thumbs.db
*.log
.env
.env.*
~$*
*.tmp
*.bak
qa/
artifacts/
output/
tmp/

# Серверный код интеграции и шаблон без секретов.
/server/*
!/server/*.mjs
!/.env.example
*.dpapi
