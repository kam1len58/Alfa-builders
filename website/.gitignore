# В репозиторий входят только сайт, исходные данные и средства его запуска/обновления.
/*
!/.gitignore
!/README.md
!/THIRD_PARTY_NOTICES
!/package.json
!/server.mjs
!/server/
!/dist/
!/data/

/data/*
!/data/*.xlsx
!/data/*.json

# Локальные настройки, инструменты агента и временные результаты.
.openai/
.codex/
.vscode/
.idea/
AGENTS.md
node_modules/
__pycache__/
*.pyc
.DS_Store
Thumbs.db
*.log
.env
.env.*
~$*
*.tmp
*.bak
qa/
artifacts/
output/
tmp/

# Серверный код интеграции и шаблон без секретов.
/server/*
!/server/*.mjs
!/.env.example
*.dpapi
