# В репозиторий входят только сайт, исходные данные и средства его запуска/обновления.
/*
!/.gitignore
!/README.md
!/THIRD_PARTY_NOTICES
!/package.json
!/server.mjs
!/dist/
!/data/
!/scripts/

/data/*
!/data/*.xlsx
!/data/*.json
/scripts/*
!/scripts/import_preview.py

# Локальные настройки, инструменты агента и временные результаты.
.openai/
.codex/
.vscode/
.idea/
AGENTS.md
node_modules/
__pycache__/
*.pyc
.DS_Store
Thumbs.db
*.log
.env
.env.*
~$*
*.tmp
*.bak
qa/
artifacts/
output/
tmp/
